    "dataformatId": 8,
    "keepRasters": true
  },
  "paths": {
    "processed": "inputi_obradjeni",
    "outputs": "finali/laz",
    "rasters": "backend/rasters/batch",
    "pipelines": "backend/pipelines/batch",
    "logs": "backend/logs",
    "status": "backend/status"
  },
  "groups": [
    {
      "name": "Example",
      "source": "Lidar data",
      "moveWhenDone": false
    }
  ]
